.venv/
__pycache__/
*.py[cod]
.DS_Store

# Downloaded audio for --song. Re-fetchable, often large, and not ours to
# redistribute. Comments go on their own line: git has no trailing-comment
# syntax, so ".song-cache/  # note" is a pattern that matches nothing and
# silently committed a 57 MB download.
.song-cache/
flexlog.csv

# Instruments you designed are yours, not the project's. Delete the file
# to start over; nothing breaks if it is missing.
instruments.json

# Performances and exported loops — audio, not source.
recordings/

# A cover's backing part and its reference MIDI are rendered from the score
# beside them, so the .json is the source and these are build output. Keeping
# the audio out also keeps a transcription of someone's record out of the repo.
covers/*.wav
covers/*.mid
